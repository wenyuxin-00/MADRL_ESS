\@writefile{toc}{\contentsline {section}{\numberline {1}High-Probability Questions 高概率问题}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}1. Why use MADRL instead of centralized optimization or MPC?\\为什么使用 MADRL，而不是直接使用集中式优化或 MPC？}{1}{subsection.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.2}2. Is your MADRL framework centralized training with decentralized execution?\\你的 MADRL 是 centralized training decentralized execution 吗？}{1}{subsection.1.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.3}3. Why does the soft EV constraint perform poorly? Is it only because the penalty weight is insufficient?\\为什么 soft EV constraint 表现不好？只是因为 penalty 权重不够吗？}{1}{subsection.1.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.4}4. Why is the Progress penalty more effective than simply increasing the EV cost weight?\\为什么 Progress penalty 比单纯增加 EV cost weight 更有效？}{2}{subsection.1.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.5}5. Why can the hard EV constraint improve departure SoC? Does it damage RL learning?\\Hard EV constraint 为什么能改善 departure SoC？它是否破坏 RL 学习？}{2}{subsection.1.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.6}6. What is the essential difference between safety projection and reward penalty?\\Safety projection 和 reward penalty 的本质区别是什么？}{2}{subsection.1.6}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Medium-Probability Questions 中概率问题}{2}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}7. Why does economic performance decrease after projection improves safety?\\为什么 projection 改善安全性后，经济性会下降？}{3}{subsection.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}8. What does a flat or non-smooth Q landscape mean for the actor?\\Q landscape 出现 flat region 或 non-smooth 对 actor 有什么影响？}{3}{subsection.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}9. Why is the effect of the price-aware penalty limited?\\为什么 price-aware penalty 的效果有限？}{3}{subsection.2.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}10. Why choose the 70\% quantile as the price-aware threshold?\\为什么选择 70\% quantile 作为 price-aware threshold？}{3}{subsection.2.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}11. Why is V2G not considered? Does this affect the conclusion?\\为什么 EV 不考虑 V2G？这会不会影响结论？}{4}{subsection.2.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}Critical Questions 尖锐问题}{4}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}12. Your reward has many penalty terms. Are the results mainly driven by parameter tuning?\\你的 reward 有很多 penalty，结果是不是调参驱动的？}{4}{subsection.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}13. Why not use constrained RL, such as Lagrangian methods or CPO?\\为什么不用 constrained RL，例如 Lagrangian method 或 CPO？}{4}{subsection.3.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}14. Does projection create inconsistency between training and execution?\\Projection 会不会导致训练和执行不一致？}{4}{subsection.3.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}15. Are the baselines fair? Do MADRL and MPC use the same forecast information?\\Baseline 是否公平？MADRL 和 MPC 是否使用相同预测信息？}{5}{subsection.3.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}16. If MADRL does not clearly outperform MPC, what is your contribution?\\如果 MADRL 没有明显超过 MPC，你的贡献是什么？}{5}{subsection.3.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.6}17. Why only three prosumers? Can the method scale?\\为什么只有 3 个 prosumer？能否扩展？}{5}{subsection.3.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.7}18. If the actor only uses local observations, how can it handle global grid safety?\\Actor 只用 local observation，如何处理 global grid safety？}{5}{subsection.3.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.8}19. How do LSTM forecast errors affect MADRL performance?\\LSTM 预测误差对 MADRL 有什么影响？}{6}{subsection.3.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.9}20. Which controller would you recommend in practice?\\如果实际应用，你最推荐哪个 controller？}{6}{subsection.3.9}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}General Answering Framework 万能回答框架}{6}{section.4}\protected@file@percent }
